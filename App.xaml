<Application x:Class="POS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:POS.Resources"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <conv:NuloAColapsadoConverter x:Key="NuloAColapsado"/>
            <conv:BoolAVisibleConverter x:Key="BoolAVisible"/>
            <conv:EsNuevoATituloConverter x:Key="EsNuevoATitulo"/>
            <conv:BoolAVisibleInvertidoConverter x:Key="BoolAVisibleInvertido"/>
            <conv:NuloAColapsadoObjetoConverter x:Key="NuloAColapsadoObjeto"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>