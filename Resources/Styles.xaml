<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         PALETA: Oscura profesional, naranja para acciones y azul para acentos
         Naranja = acción principal | Azul = navegación y acciones secundarias
         =================================================================== -->

    <!-- Naranja -->
    <SolidColorBrush x:Key="ColorPrimario" Color="#F97316"/>
    <SolidColorBrush x:Key="ColorPrimarioHover" Color="#EA580C"/>

    <!-- Azul medianoche -->
    <SolidColorBrush x:Key="ColorAcento" Color="#4DA3FF"/>
    <SolidColorBrush x:Key="ColorAcentoClaro" Color="#233B58"/>

    <!-- Blanco y negro -->
    <SolidColorBrush x:Key="ColorFondo" Color="#0B1220"/>
    <SolidColorBrush x:Key="ColorTarjeta" Color="#111C2E"/>
    <SolidColorBrush x:Key="ColorTexto" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ColorTextoSecundario" Color="#A8B6C8"/>
    <SolidColorBrush x:Key="ColorBorde" Color="#2A3A50"/>
    <SolidColorBrush x:Key="ColorBordeInput" Color="#40516A"/>

    <!-- Estados (se mantienen dentro de la paleta; el rojo solo para acciones destructivas) -->
    <SolidColorBrush x:Key="ColorExito" Color="#34D399"/>
    <SolidColorBrush x:Key="ColorExitoHover" Color="#10B981"/>
    <SolidColorBrush x:Key="ColorAviso" Color="#FDBA74"/>
    <SolidColorBrush x:Key="ColorPeligro" Color="#DC2626"/>
    <SolidColorBrush x:Key="ColorPeligroHover" Color="#B91C1C"/>

    <!-- Sombras (ya no se usan en el estilo minimalista; se conservan por compatibilidad) -->
    <DropShadowEffect x:Key="SombraTarjeta" Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.22" Direction="270"/>
    <DropShadowEffect x:Key="SombraBoton" Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.20" Direction="270"/>

    <!-- ===================================================================
         BOTONES
         Estados: hover, presionado y deshabilitado se logran con Opacity,
         así funcionan aunque el botón tenga un Background propio.
         =================================================================== -->

    <!-- Botón grande: acción principal (COBRAR, CONFIRMAR VENTA) -->
    <Style x:Key="BotonGrande" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.90"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón normal: acciones secundarias (azul) -->
    <Style x:Key="BotonNormal" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ColorAcento}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.90"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón secundario: fondo blanco con borde azul (NUEVO) -->
    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ColorTarjeta}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorAcento}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorAcento}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource ColorAcentoClaro}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón destructivo (eliminar, anular) -->
    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonNormal}">
        <Setter Property="Background" Value="{StaticResource ColorPeligro}"/>
    </Style>

    <!-- ===================================================================
         TARJETAS Y CAJAS
         =================================================================== -->

    <!-- Tarjeta: blanca, plana, con borde fino -->
    <Style x:Key="TarjetaProducto" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorTarjeta}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Caja de texto: borde gris, se resalta en naranja al escribir -->
    <Style x:Key="CajaTexto" TargetType="TextBox">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        <Setter Property="Background" Value="{StaticResource ColorTarjeta}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBordeInput}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ColorFondo}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilos automáticos para controles sin estilo propio (misma paleta) -->
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        <Setter Property="Background" Value="{StaticResource ColorTarjeta}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBordeInput}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        <Setter Property="Background" Value="{StaticResource ColorTarjeta}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBordeInput}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ===================================================================
         TEXTOS
         =================================================================== -->

    <Style x:Key="TituloSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorAcento}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="TextoTotal" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
    </Style>

    <Style x:Key="MensajeError" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorAviso}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

</ResourceDictionary>