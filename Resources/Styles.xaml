<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colores -->
    <SolidColorBrush x:Key="ColorPrimario" Color="#F97316"/>
    <SolidColorBrush x:Key="ColorPrimarioHover" Color="#0C2C55"/>
    <SolidColorBrush x:Key="ColorAcento" Color="#3B4F6B"/>
    <SolidColorBrush x:Key="ColorAcentoClaro" Color="#93C5FD"/>
    <SolidColorBrush x:Key="ColorTarjeta" Color="#79C9C5"/>
    <SolidColorBrush x:Key="ColorExito" Color="#16A34A"/>
    <SolidColorBrush x:Key="ColorExitoHover" Color="#15803D"/>
    <SolidColorBrush x:Key="ColorPeligro" Color="#DC2626"/>
    <SolidColorBrush x:Key="ColorPeligroHover" Color="#B91C1C"/>
    <SolidColorBrush x:Key="ColorAviso" Color="#D97706"/>
    <SolidColorBrush x:Key="ColorFondo" Color="#FFCF7C"/>
    <SolidColorBrush x:Key="ColorTexto" Color="#1E293B"/>
    <SolidColorBrush x:Key="ColorTextoSecundario" Color="#64748B"/>
    <SolidColorBrush x:Key="ColorBorde" Color="#F96E5B"/>

    <!-- Sombra suave reutilizable -->
    <DropShadowEffect x:Key="SombraTarjeta" Color="#1E293B" BlurRadius="16" ShadowDepth="3" Opacity="0.10" Direction="270"/>
    <DropShadowEffect x:Key="SombraBoton" Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.18" Direction="270"/>

    <!-- Botón grande (COBRAR, acciones principales) -->
    <Style x:Key="BotonGrande" TargetType="Button">
        <Setter Property="Effect" Value="{StaticResource SombraBoton}"/>
        <Setter Property="Background" Value="{StaticResource ColorExito}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorExitoHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ColorBorde}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón normal (acciones secundarias) -->
    <Style x:Key="BotonNormal" TargetType="Button">
        <Setter Property="Effect" Value="{StaticResource SombraBoton}"/>
        <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorPrimarioHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón destructivo (eliminar, cancelar) -->
    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonNormal}">
        <Setter Property="Background" Value="{StaticResource ColorPeligro}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorPeligroHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tarjeta de producto -->
    <Style x:Key="TarjetaProducto" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorTarjeta}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource SombraTarjeta}"/>
    </Style>

    <!-- Caja de texto -->
    <Style x:Key="CajaTexto" TargetType="TextBox">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <!-- Texto de título -->
    <Style x:Key="TituloSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Texto de total -->
    <Style x:Key="TextoTotal" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
    </Style>

    <!-- Mensaje de error -->
    <Style x:Key="MensajeError" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource ColorAviso}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

</ResourceDictionary>