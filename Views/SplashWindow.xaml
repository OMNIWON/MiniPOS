<Window x:Class="POS.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Height="260" Width="400" Topmost="True"
        ShowInTaskbar="False">
    <Border Background="{StaticResource ColorAcento}" CornerRadius="16">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
            <TextBlock Text="PUNTO DE VENTA" FontSize="26" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Gas LP y Ferretería" FontSize="14"
                       Foreground="{StaticResource ColorAcentoClaro}" HorizontalAlignment="Center" Margin="0,6,0,24"/>
            <ProgressBar IsIndeterminate="True" Height="6"
                         Foreground="{StaticResource ColorPrimario}"
                         Background="#33FFFFFF" BorderThickness="0"/>
            <TextBlock Text="Cargando..." FontSize="13" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
    </Border>
</Window>