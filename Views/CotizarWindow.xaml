<Window x:Class="POS.Views.CotizarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cotizar" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource ColorFondo}"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="COTIZACIÓN" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource ColorTexto}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="⬅ Regresar al menú" Style="{StaticResource BotonNormal}"
                    Background="{StaticResource ColorTextoSecundario}" Click="RegresarAlMenu_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- IZQUIERDA: BUSCAR PRODUCTO -->
            <Border Grid.Column="0" Style="{StaticResource TarjetaProducto}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Buscar producto" Style="{StaticResource TituloSeccion}"/>
                    <TextBox Grid.Row="1" Style="{StaticResource CajaTexto}"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProductosEncontrados}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TarjetaProducto}" Width="220">
                                        <StackPanel>
                                            <Border Height="150" CornerRadius="8" Margin="0,0,0,6"
                                                    Background="{StaticResource ColorFondo}" ClipToBounds="True">
                                                <Image Source="{Binding RutaImagen}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Foreground="{StaticResource ColorTexto}"/>
                                            <TextBlock Text="{Binding PrecioVenta, StringFormat='{}{0:C2}'}"
                                                       FontSize="16" FontWeight="Bold" Margin="0,3,0,0"
                                                       Foreground="{StaticResource ColorTexto}"/>
                                            <TextBlock Text="{Binding Existencia, StringFormat='Existencia: {0}'}"
                                                       FontSize="12" Foreground="{StaticResource ColorTextoSecundario}"
                                                       Margin="0,2,0,8"/>
                                            <Button Content="➕ Agregar" Style="{StaticResource BotonNormal}"
                                                    Command="{Binding DataContext.AgregarAlCarritoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- DERECHA: COTIZACIÓN -->
            <Border Grid.Column="2" Style="{StaticResource TarjetaProducto}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título + botón "Más opciones" -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Cotización" Style="{StaticResource TituloSeccion}"
                                   Margin="0" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" FontSize="13" Padding="10,6"
                                Command="{Binding AlternarOpcionesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotonNormal}">
                                    <Setter Property="Background" Value="{StaticResource ColorAcento}"/>
                                    <Setter Property="Content" Value="⚙ Más opciones ▾"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MostrarOpciones}" Value="True">
                                            <Setter Property="Content" Value="⚙ Menos opciones ▴"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Cliente con autocompletado de la agenda -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Cliente (opcional)" FontSize="13"
                                   Foreground="{StaticResource ColorTextoSecundario}"/>
                        <ComboBox IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  ItemsSource="{Binding ClientesSugeridos}"
                                  Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="18" Padding="12,10" Margin="0,2,0,0"
                                  ToolTip="Escribe el nombre o elige uno de tu agenda"/>
                    </StackPanel>

                    <!-- Carrito compacto -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Carrito}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource ColorBorde}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Producto.Nombre}"
                                                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{StaticResource ColorTexto}"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="−" Width="32" Height="32" Padding="0" FontSize="16"
                                                            Style="{StaticResource BotonNormal}"
                                                            Command="{Binding DataContext.DecrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}"
                                                             Width="54" FontSize="14" Margin="4,0" Padding="2"
                                                             TextAlignment="Center" VerticalContentAlignment="Center"/>
                                                    <Button Content="+" Width="32" Height="32" Padding="0" FontSize="16"
                                                            Style="{StaticResource BotonNormal}"
                                                            Command="{Binding DataContext.IncrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='{}{0:C2}'}"
                                                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" Foreground="{StaticResource ColorTexto}"/>

                                                <Button Grid.Column="3" Content="🗑" Width="32" Height="32" Padding="0" FontSize="14"
                                                        HorizontalAlignment="Right"
                                                        Style="{StaticResource BotonPeligro}"
                                                        Command="{Binding DataContext.QuitarDelCarritoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>

                                            <!-- Opciones secundarias: solo con "Más opciones" -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding DataContext.MostrarOpciones, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolAVisible}}">
                                                <TextBlock Text="Precio" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Foreground="{StaticResource ColorTextoSecundario}"/>
                                                <TextBox Text="{Binding PrecioUnitario, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                                         Width="95" FontSize="14" Padding="3" TextAlignment="Right" Margin="0,0,18,0"
                                                         ToolTip="Precio unitario (solo en esta cotización)"/>
                                                <TextBlock Text="Desc. %" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Foreground="{StaticResource ColorTextoSecundario}"/>
                                                <TextBox Text="{Binding DescuentoPorcentaje, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                                                         Width="60" FontSize="14" Padding="3" TextAlignment="Right"
                                                         ToolTip="Descuento de esta línea (0-100)"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" Text="{Binding MensajeInfo}" Style="{StaticResource MensajeError}"
                               Visibility="{Binding MensajeInfo, Converter={StaticResource NuloAColapsado}}"/>

                    <Grid Grid.Row="4" Margin="0,16,0,16">
                        <TextBlock Text="TOTAL" FontSize="20" VerticalAlignment="Center"
                                   Foreground="{StaticResource ColorTextoSecundario}"/>
                        <TextBlock Text="{Binding Total, StringFormat='{}{0:C2}'}"
                                   Style="{StaticResource TextoTotal}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Grid.Row="5" Content="📋 GUARDAR COTIZACIÓN" Style="{StaticResource BotonGrande}"
                            Background="{StaticResource ColorAcento}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding GuardarCotizacionCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>