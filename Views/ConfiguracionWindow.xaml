<Window x:Class="POS.Views.ConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Height="800" Width="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ColorFondo}"
        FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="CONFIGURACIÓN" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource ColorTitulo}" Margin="0,0,0,18"/>

            <Border Style="{StaticResource TarjetaProducto}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Datos del negocio (salen en el ticket)" Style="{StaticResource TituloSeccion}" FontSize="18"/>

                    <TextBlock Text="Nombre del negocio" FontSize="13" Foreground="{StaticResource ColorTextoSecundario}"/>
                    <TextBox Style="{StaticResource CajaTexto}" Text="{Binding NombreNegocio}" Margin="0,0,0,10"/>

                    <TextBlock Text="Dirección" FontSize="13" Foreground="{StaticResource ColorTextoSecundario}"/>
                    <TextBox Style="{StaticResource CajaTexto}" Text="{Binding Direccion}" Margin="0,0,0,10"/>

                    <TextBlock Text="Teléfono" FontSize="13" Foreground="{StaticResource ColorTextoSecundario}"/>
                    <TextBox Style="{StaticResource CajaTexto}" Text="{Binding Telefono}" Margin="0,0,0,10"/>

                    <TextBlock Text="Mensaje al pie del ticket" FontSize="13" Foreground="{StaticResource ColorTextoSecundario}"/>
                    <TextBox Style="{StaticResource CajaTexto}" Text="{Binding MensajeTicket}" Margin="0,0,0,10"/>

                    <TextBlock Text="Ancho del papel del ticket" FontSize="13" Foreground="{StaticResource ColorTextoSecundario}"/>
                    <ComboBox ItemsSource="{Binding AnchosDisponibles}" SelectedItem="{Binding AnchoTicketMm}"
                              ItemStringFormat="{}{0} mm" FontSize="16" Padding="10,8"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TarjetaProducto}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Impuestos" Style="{StaticResource TituloSeccion}" FontSize="18"/>

                    <CheckBox IsChecked="{Binding IvaActivo}" Margin="0,0,0,12">
                        <TextBlock Text="Aplicar IVA a las ventas" FontSize="16"/>
                    </CheckBox>

                    <TextBlock Text="Tasa de IVA (%)" FontSize="13" Foreground="{StaticResource ColorTextoSecundario}"/>
                    <TextBox Style="{StaticResource CajaTexto}" Text="{Binding TasaIva, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding PreciosIncluyenIva}" Margin="0,0,0,12">
                        <TextBlock Text="Los precios de mis productos YA incluyen el IVA" FontSize="16" TextWrapping="Wrap"/>
                    </CheckBox>

                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource ColorTextoSecundario}"
                               Text="Con precios incluidos, un artículo de $116 se desglosa como $100 + $16 de IVA y el cliente paga $116. Sin incluir, el IVA se suma: un artículo de $100 se cobra en $116."/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Mensaje}" Style="{StaticResource MensajeError}"
                       Visibility="{Binding Mensaje, Converter={StaticResource NuloAColapsado}}"/>
            <Button Content="🖨 Imprimir ticket de prueba" Style="{StaticResource BotonNormal}"
                    Background="{StaticResource ColorAcento}" Margin="0,10,0,0"
                    Click="ImprimirPrueba_Click"/>
            <Button Content="💾 Guardar" Style="{StaticResource BotonGrande}" Margin="0,10,0,8"
                    Command="{Binding GuardarCommand}"/>
            <Button Content="Cancelar" Style="{StaticResource BotonNormal}"
                    Background="{StaticResource ColorTextoSecundario}" Click="Cancelar_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>