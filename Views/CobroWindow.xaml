<Window x:Class="POS.Views.CobroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobro" Height="750" Width="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource ColorFondo}"
        FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="600" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="COBRO" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource ColorAcento}" Margin="0,0,0,16"/>

            <Border Grid.Row="1" Style="{StaticResource TarjetaProducto}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6" Visibility="{Binding MuestraDesglose, Converter={StaticResource BoolAVisible}}">
                        <TextBlock Text="Subtotal" FontSize="16" Foreground="{StaticResource ColorTextoSecundario}"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat='{}{0:C2}'}" FontSize="18"
                                   HorizontalAlignment="Right" Foreground="{StaticResource ColorTexto}"/>
                    </Grid>
                    <Grid Margin="0,0,0,6" Visibility="{Binding MuestraDesglose, Converter={StaticResource BoolAVisible}}">
                        <TextBlock Text="IVA" FontSize="16" Foreground="{StaticResource ColorTextoSecundario}"/>
                        <TextBlock Text="{Binding Impuestos, StringFormat='{}{0:C2}'}" FontSize="18"
                                   HorizontalAlignment="Right" Foreground="{StaticResource ColorTexto}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="TOTAL" FontSize="18" Foreground="{StaticResource ColorTextoSecundario}"/>
                        <TextBlock Text="{Binding Total, StringFormat='{}{0:C2}'}" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Right" Foreground="{StaticResource ColorTexto}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="RECIBIDO" FontSize="18" Foreground="{StaticResource ColorTextoSecundario}"/>
                        <TextBlock Text="{Binding DineroRecibido, StringFormat='{}{0:C2}'}" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Right" Foreground="{StaticResource ColorPrimario}"/>
                    </Grid>
                    <Separator Margin="0,6"/>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="CAMBIO" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}"/>
                        <TextBlock Text="{Binding Cambio, StringFormat='{}{0:C2}'}" FontSize="38" FontWeight="Bold"
                                   HorizontalAlignment="Right" Foreground="{StaticResource ColorExito}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,12">
                <Button Content="💵 Efectivo" FontSize="20" Margin="4" Command="{Binding SeleccionarEfectivoCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonNormal}">
                            <Setter Property="Background" Value="{StaticResource ColorBorde}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsEfectivo}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ColorAcento}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="💳 Tarjeta" FontSize="20" Margin="4" Command="{Binding SeleccionarTarjetaCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonNormal}">
                            <Setter Property="Background" Value="{StaticResource ColorBorde}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsTarjeta}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ColorAcento}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <StackPanel Grid.Row="3" Margin="0,0,0,12"
                        Visibility="{Binding EsEfectivo, Converter={StaticResource BoolAVisible}}">
                <TextBox Style="{StaticResource CajaTexto}" FontSize="26" TextAlignment="Center"
                         Text="{Binding DineroRecibido, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                         Margin="0,0,0,12"/>

                <UniformGrid Columns="3" Rows="3">
                    <Button Content="$5" Style="{StaticResource BotonNormal}" FontSize="20" Margin="4"
                            Command="{Binding AgregarMontoCommand}" CommandParameter="5"/>
                    <Button Content="$10" Style="{StaticResource BotonNormal}" FontSize="20" Margin="4"
                            Command="{Binding AgregarMontoCommand}" CommandParameter="10"/>
                    <Button Content="$20" Style="{StaticResource BotonNormal}" FontSize="20" Margin="4"
                            Command="{Binding AgregarMontoCommand}" CommandParameter="20"/>
                    <Button Content="$50" Style="{StaticResource BotonNormal}" FontSize="20" Margin="4"
                            Command="{Binding AgregarMontoCommand}" CommandParameter="50"/>
                    <Button Content="$100" Style="{StaticResource BotonNormal}" FontSize="20" Margin="4"
                            Command="{Binding AgregarMontoCommand}" CommandParameter="100"/>
                    <Button Content="$200" Style="{StaticResource BotonNormal}" FontSize="20" Margin="4"
                            Command="{Binding AgregarMontoCommand}" CommandParameter="200"/>
                    <Button Content="$500" Style="{StaticResource BotonNormal}" FontSize="20" Margin="4"
                            Command="{Binding AgregarMontoCommand}" CommandParameter="500"/>
                    <Button Content="$1000" Style="{StaticResource BotonNormal}" FontSize="20" Margin="4"
                            Command="{Binding AgregarMontoCommand}" CommandParameter="1000"/>
                    <Button Content="Limpiar" Style="{StaticResource BotonPeligro}" FontSize="18" Margin="4"
                            Command="{Binding LimpiarMontoCommand}"/>
                </UniformGrid>

                <Button Content="PAGO EXACTO" Style="{StaticResource BotonNormal}"
                        Background="{StaticResource ColorAcento}" FontSize="20" Margin="4,8,4,0"
                        Command="{Binding PagoExactoCommand}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Cobra en la terminal y luego presiona CONFIRMAR VENTA."
                       FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"
                       Foreground="{StaticResource ColorTextoSecundario}"
                       Visibility="{Binding EsTarjeta, Converter={StaticResource BoolAVisible}}"/>

            <StackPanel Grid.Row="4">
                <Button Content="✅ CONFIRMAR VENTA" Style="{StaticResource BotonGrande}"
                        IsEnabled="{Binding PuedeConfirmar}" Click="Confirmar_Click"/>

                <Button Content="Cancelar" Style="{StaticResource BotonNormal}"
                        Background="{StaticResource ColorTextoSecundario}" Margin="0,10,0,0"
                        Click="Cancelar_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>