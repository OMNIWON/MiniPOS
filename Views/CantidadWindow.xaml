<Window x:Class="POS.Views.CantidadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cantidad" Height="290" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource ColorFondo}"
        FontFamily="Segoe UI">

    <StackPanel Margin="24">
        <TextBlock x:Name="TextoPregunta" FontSize="18" TextWrapping="Wrap"
                   Foreground="{StaticResource ColorTexto}" Margin="0,0,0,14"/>

        <TextBox x:Name="CajaCantidad" Style="{StaticResource CajaTexto}" FontSize="24" TextAlignment="Center"/>

        <TextBlock x:Name="TextoError" Style="{StaticResource MensajeError}" Visibility="Collapsed"/>

        <UniformGrid Columns="2" Margin="0,18,0,0">
            <Button Content="✅ Aceptar" Style="{StaticResource BotonGrande}" FontSize="18" Margin="0,0,6,0"
                    IsDefault="True" Click="Aceptar_Click"/>
            <Button Content="Cancelar" Style="{StaticResource BotonNormal}" FontSize="18" Margin="6,0,0,0"
                    Background="{StaticResource ColorTextoSecundario}" IsCancel="True"/>
        </UniformGrid>
    </StackPanel>
</Window>