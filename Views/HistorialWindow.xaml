<Window x:Class="POS.Views.HistorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ColorFondo}"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="HISTORIAL" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource ColorTextoSecundario}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="⬅ Regresar al menú" Style="{StaticResource BotonNormal}"
                    Background="{StaticResource ColorTextoSecundario}" Click="RegresarAlMenu_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="🛒 Ventas" Style="{StaticResource BotonNormal}" Margin="0,0,8,0"
                    Command="{Binding VerVentasCommand}"/>
            <Button Content="📋 Cotizaciones" Style="{StaticResource BotonNormal}"
                    Background="{StaticResource ColorAcento}"
                    Command="{Binding VerCotizacionesCommand}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource TarjetaProducto}"
                    Visibility="{Binding MostrandoVentas, Converter={StaticResource BoolAVisible}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Ventas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource ColorBorde}" BorderThickness="0,0,0,1" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                   FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource ColorTexto}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:C2}'}"
                                                   FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource ColorPrimario}"/>
                                        <Button Grid.Column="2" Content="Ver" Style="{StaticResource BotonNormal}" Padding="8,6"
                                                Command="{Binding DataContext.SeleccionarVentaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="0" Style="{StaticResource TarjetaProducto}"
                    Visibility="{Binding MostrandoVentas, Converter={StaticResource BoolAVisibleInvertido}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Cotizaciones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource ColorBorde}" BorderThickness="0,0,0,1" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                       FontSize="15" Foreground="{StaticResource ColorTexto}"/>
                                            <TextBlock Text="{Binding Cliente, StringFormat='Cliente: {0}'}"
                                                       FontSize="12" Foreground="{StaticResource ColorTextoSecundario}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:C2}'}"
                                                   FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource ColorAcento}"/>
                                        <Button Grid.Column="2" Content="Ver" Style="{StaticResource BotonNormal}" Padding="8,6"
                                                Command="{Binding DataContext.SeleccionarCotizacionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource TarjetaProducto}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Detalle" Style="{StaticResource TituloSeccion}"/>

                        <StackPanel Visibility="{Binding VentaSeleccionada, Converter={StaticResource NuloAColapsadoObjeto}}">
                            <ItemsControl ItemsSource="{Binding VentaSeleccionada.Detalles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding NombreProducto}" FontSize="14"
                                                       TextWrapping="Wrap" Foreground="{StaticResource ColorTexto}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Cantidad}" FontSize="14"
                                                       Foreground="{StaticResource ColorTextoSecundario}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='{}{0:C2}'}"
                                                       FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource ColorTexto}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="{Binding VentaSeleccionada.Subtotal, StringFormat='Subtotal: {0:C2}'}" FontSize="14"/>
                            <TextBlock Text="{Binding VentaSeleccionada.Total, StringFormat='Total: {0:C2}'}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding VentaSeleccionada.DineroRecibido, StringFormat='Recibido: {0:C2}'}" FontSize="14" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding VentaSeleccionada.Cambio, StringFormat='Cambio: {0:C2}'}" FontSize="14"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding CotizacionSeleccionada, Converter={StaticResource NuloAColapsadoObjeto}}">
                            <TextBlock Text="{Binding CotizacionSeleccionada.Cliente, StringFormat='Cliente: {0}'}" FontSize="14" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding CotizacionSeleccionada.Detalles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding NombreProducto}" FontSize="14"
                                                       TextWrapping="Wrap" Foreground="{StaticResource ColorTexto}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Cantidad}" FontSize="14"
                                                       Foreground="{StaticResource ColorTextoSecundario}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='{}{0:C2}'}"
                                                       FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource ColorTexto}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="{Binding CotizacionSeleccionada.Total, StringFormat='Total: {0:C2}'}" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>