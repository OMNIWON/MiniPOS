<Window x:Class="POS.Views.NotasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notas del registro" Height="620" Width="760" MinHeight="500" MinWidth="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource ColorFondo}" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Notas del registro" Style="{StaticResource TituloSeccion}"
                   FontSize="26" Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Nota 1" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource ColorTexto}" Margin="0,0,0,6"/>
            <TextBox x:Name="Nota1TextBox" Grid.Row="1" Style="{StaticResource CajaTexto}" FontSize="16"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Nota 2" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource ColorTexto}" Margin="0,0,0,6"/>
            <TextBox x:Name="Nota2TextBox" Grid.Row="1" Style="{StaticResource CajaTexto}" FontSize="16"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    MinWidth="130" Height="50" Margin="0,0,12,0" IsCancel="True"/>
            <Button Content="Guardar notas" Style="{StaticResource BotonGrande}"
                    MinWidth="170" Height="50" FontSize="18" Padding="14,6" Click="Guardar_Click"/>
        </StackPanel>
    </Grid>
</Window>