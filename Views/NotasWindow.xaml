<Window x:Class="POS.Views.NotasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notas del registro" Height="620" Width="760" MinHeight="500" MinWidth="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Notas del registro" FontSize="24" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,18"/>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Nota 1" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
            <TextBox x:Name="Nota1TextBox" Grid.Row="1" FontSize="16" Padding="10" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" SpellCheck.IsEnabled="True"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Nota 2" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
            <TextBox x:Name="Nota2TextBox" Grid.Row="1" FontSize="16" Padding="10" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" SpellCheck.IsEnabled="True"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" MinWidth="120" Height="44" Margin="0,0,10,0" IsCancel="True" FontSize="16" Padding="14,6"/>
            <Button Content="Guardar notas" MinWidth="150" Height="44" FontSize="16" FontWeight="SemiBold" Background="#F97316" Foreground="White" BorderThickness="0" Padding="14,6" Click="Guardar_Click"/>
        </StackPanel>
    </Grid>
</Window>